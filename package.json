{
  "name": "idlehub",
  "version": "1.3.0",
  "description": "IdleHub by ovelhaohb — hub desktop para centralizar e acompanhar jogos idle de navegador.",
  "main": "src/main.js",
  "author": "OvelhaoHb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovelhaohb/ovelhaohb-hub-idle.git"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.ovelhaohb.idleshub",
    "productName": "IdleHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "posthog-node": "^5.52.5"
  }
}
